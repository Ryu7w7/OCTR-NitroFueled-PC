            <Line Type="bytes" Address="0x653740" Value="E9CA6B0E0290909090"
                  Signature="90 90 90 90 90 90 90 90 48 8b 7f 10 e9 c7 ad ff ff 90 90 90 90 90 90 90 55"
                  SignatureOffset="0x8"/>
            <!-- Custom Cup: winning it marks no cup's stars -->
            <Line Type="bytes" Address="0x159de42" Value="E95BC319019090"
                  Signature="0a 00 93 01 48 89 45 b8 48 8b 80 88 0d 00 00 48 85 c0 0f 84 a7 00 00"
                  SignatureOffset="0x8"/>
            <!-- Custom Cup: a track chosen twice counts as the race being played, not as its first race -->
            <Line Type="bytes" Address="0x13dde10" Value="E9C2CF3501909090"
                  Signature="5d c3 90 90 90 90 90 90 90 90 90 90 55 48 89 e5 41 57 41 56 41 55 41 54 53 48 83 ec 18 48 8b 15"
                  SignatureOffset="0xc"/>
        </PatchList>
    </Metadata>
