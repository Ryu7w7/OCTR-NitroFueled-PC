<?xml version="1.0" encoding="utf-8"?>
<!-- Custom Cup: a cup of four tracks of your choice, offline. R1 "Personalizada" on the cup
     menu opens the track menu to choose them; on the single race track menu R1 "Personalizada"
     turns the choosing on. While choosing, Cross adds the track ("Pista n de 4", its picture in a row
     of thumbnails; Circle takes the last one out); the fourth one
     starts the cup as the cup menu does (its race settings, then four races and standings).
     Circle goes back to the menu it was started from. Winning it marks no cup's stars. -->
<Patch>
    <TitleID>
        <ID>CUSA13795</ID>
    </TitleID>
    <Metadata Title="Crash Team Racing Nitro-Fueled"
              Name="Custom Cup"
              Note="A cup of four tracks of your choice: R1 on the cup menu or on the single race track menu, then Cross on four tracks. Offline."
              Author="Kyouko8"
              PatchVer="1.5.0"
              AppVer="01.21"
              AppElf="eboot.bin"
              isEnabled="true">
        <PatchList>
            <!-- Custom Cup: its code (the track menu, the cup menu button, the cup it builds) -->
            <Line Type="bytes" Address="0x273a000" Value=""
                  ExpectedSHA256="e8d9b86f00b0113bdd8266e4d4d08f4bb2f3978ac31d5e86119e36d7d55b92f0"/>
            <!-- Custom Cup: while choosing, Cross on a track adds it; R1 turns the choosing on and off -->
            <Line Type="bytes" Address="0x167b2da" Value="E921ED0B01909090909090"
                  Signature="00 00 00 e9 99 09 00 00 41 83 7f 18 08 0f 84 15 01 00 00 49 8b 45 00 48 3b 45 d0"
                  SignatureOffset="0x8"/>
            <!-- Custom Cup: the track menu button bar (R1 "Personalizada", Cross "Pista n de 4") -->
            <Line Type="bytes" Address="0x167b38c" Value="E91DED0B019090"
                  Signature="8b 40 20 e9 75 01 00 00 48 8b 3d 85 88 86 01 49 8b 74 24 78 4c 89 b5"
                  SignatureOffset="0x8"/>
            <!-- Custom Cup: the fourth track sets up the cup, which starts on its first track -->
            <Line Type="bytes" Address="0x167b414" Value="E9D6EC0B01909090909090"
                  Signature="85 c0 0f 84 d1 fe ff ff 48 8b 40 10 48 8d 35 9c d8 b1 00 48 8d bd 30 ff ff ff 4c"
                  SignatureOffset="0x8"/>
            <!-- Custom Cup: R1 "Personalizada" on the cup menu opens the track menu to choose -->
            <Line Type="bytes" Address="0x167c6b0" Value="E98BDA0B01909090"
                  Signature="44 82 22 00 90 90 90 90 55 48 89 e5 41 57 41 56 41 55 41 54 53 48 81 ec"
                  SignatureOffset="0x8"/>
            <!-- Custom Cup: Circle goes back to the menu the cup was started from -->
            <Line Type="bytes" Address="0xe063d0" Value="E99C3D9301909090"
                  Signature="eb c2 90 90 90 90 90 90 90 90 90 90 90 90 90 90 55 48 89 e5 41 57 41 56 41 55 41 54 53 48 83 ec 38 4c 8b 25 b0 0c e0 01"
