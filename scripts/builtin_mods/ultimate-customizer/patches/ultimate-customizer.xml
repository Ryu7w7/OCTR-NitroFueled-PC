<?xml version="1.0" encoding="utf-8"?>
<!-- Race and battle options: the executable side of three-digit lap counts and long races.
     The lap menu and the HUD lap counter print their numbers with the game's own three-digit
     string builder (0x9bf710) instead of its one- and two-digit twins (0x9b5b70, 0xb39870),
     which are the same code with less room; nothing else that uses those twins changes.
     The race clock already switches to MM:SS:CC past ten minutes in races of 7 laps or more;
     here it does so for any lap count and goes on to 999:59:99, with room for the third digit.
     A race's achievement events are sent 512 at most, so races of hours do not run the
     MP_NETWORK pool out at the finish. The cup menu finds a cup by its first track among cup
     starts only, so added cups keep their own tracks. The added cups keep their stars in
     /savedata0/rbo_cups.bin, and Square on the cup menu picks a random cup. -->
<Patch>
    <TitleID>
        <ID>CUSA13795</ID>
    </TitleID>
    <Metadata Title="Crash Team Racing Nitro-Fueled"
              Name="Ultimate Customizer"
              Note="Laps up to 3 digits in the menu and the HUD; race clock up to 999:59:99; long races without running out of network memory; random cup with Square. Kyouko8 (Ultimate Customizer)."
              Author="Kyouko8"
              PatchVer="5.1.0"
              AppVer="01.21"
              AppElf="eboot.bin"
              isEnabled="true">
        <PatchList>
            <!-- Cup stars: the code for the added cups (their table, its file) -->
