# Windows launchers need CRLF; scripts for Linux/MSYS2 need LF. Everything else is left as is.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
run.py text eol=lf
# Layout payload checksums cover exact bytes on every checkout platform.
scripts/widescreen_data/** text eol=lf
