// ryunet-bridge.exe's version information and manifest (eosbridge/build.sh compiles it with windres):
// what Windows' file properties show, and an ordinary program to antivirus heuristics.
// BRIDGE_VERSION (a,b,c,d) and BRIDGE_VERSION_TEXT come from build.sh (BB_VERSION).
#include <winver.h>

#ifndef BRIDGE_VERSION
#define BRIDGE_VERSION 0,0,0,0
#endif
#ifndef BRIDGE_VERSION_TEXT
#define BRIDGE_VERSION_TEXT "0.0.0"
#endif

1 VERSIONINFO
FILEVERSION BRIDGE_VERSION
PRODUCTVERSION BRIDGE_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OCTR (Ryu7w7/OCTR-NitroFueled-PC)"
            VALUE "FileDescription", "RyuNET EOS bridge: online for SacredFire through Epic Online Services"
            VALUE "FileVersion", BRIDGE_VERSION_TEXT
            VALUE "InternalName", "ryunet-bridge"
            VALUE "LegalCopyright", "GPL-2.0-or-later, OCTR contributors"
            VALUE "OriginalFilename", "ryunet-bridge.exe"
            VALUE "ProductName", "SacredFire (CTR Nitro-Fueled PC port)"
            VALUE "ProductVersion", BRIDGE_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 24 "ryunet-bridge.manifest"
