<?xml version="1.0" encoding="utf-8"?>
<!-- The European edition (CUSA14876) 1.21: the online patch of CrashTeamRacingOnline.xml (the
     RyuNET server's RSA-2048 key in place of Demonware's, the same value). The key sits 0x40
     earlier than in the USA build, next to "DW-RSAENC"; it is found by signature (the DER header
     and the start of Demonware's own modulus), the address given is this build's. The in-game
     switch selects it as the same patch (patches.py BUNDLED_FILES). -->
<Patch>
    <TitleID>
        <ID>CUSA14876</ID>
    </TitleID>
    <Metadata Title="Crash Team Racing Nitro-Fueled"
              Name="Online: custom Demonware key"
              Note="Replaces official Demonware RSA-2048 public key with server custom key for auth response signature verification"
              Author="RyuNET / SacredFire"
              PatchVer="1.0"
              AppVer="01.21"
              AppElf="eboot.bin">
        <PatchList>
            <Line Type="bytes" Address="0x1fecf61" Value=""
                  Signature="30 82 01 0a 02 82 01 01 00 c0 a2 0b 1f 6c b8 1b 12" SignatureOffset="0x9"/>
        </PatchList>
    </Metadata>
</Patch>
